APP_NAME="勤怠管理 (ローカル)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
STAFFHUB_ALLOW_REMOTE_DATABASE=false

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

STAFFHUB_COMPANY_NAME="社会福祉法人 誠心福祉会 池上わかばこども園"
STAFFHUB_LOCATION_NAME="池上わかばこども園"
STAFFHUB_PDF_FONT_PATH=storage/app/fonts/BIZUDGothic-Regular.ttf
STAFFHUB_ADMIN_EMAIL=admin@example.test
STAFFHUB_ADMIN_PASSWORD=change-this-local-password
STAFFHUB_ADMIN_NAME="ローカル管理者"
STAFFHUB_DEVICE_CODE=local-device
STAFFHUB_DEVICE_SECRET=change-this-local-device-secret
STAFFHUB_DEVICE_NAME="ローカル打刻端末"
STAFFHUB_DEVICE_LOCATION="開発環境"
